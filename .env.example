# Copy to .env and fill in. .env is gitignored.

# --- LLM (chat assistant) ---
# Leave ANTHROPIC_API_KEY empty to run without the chat (the rest of the app still works).
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
LLM_MAX_TOKENS=4096

# --- Backend ---
DEFAULT_REGION=eu-west-3
DATABASE_PATH=/data/archi.db
ENABLE_TF_FMT=true
# Comma-separated list of allowed CORS origins (only needed when the frontend is served elsewhere)
CORS_ORIGINS=

# --- HTTPS (Caddy option, see docker-compose.yml) ---
DOMAIN=
ACME_EMAIL=
